# The Odds API Configuration
# Get your free API key at: https://the-odds-api.com/
#
# IMPORTANT: Copy this file to .env.local and replace REPLACE_ME with your actual API key
# Never commit .env.local to Git!

ODDS_API_KEY=REPLACE_ME
