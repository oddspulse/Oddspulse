# The Odds API Configuration
# Copy this file to .env.local and fill in your API key

ODDS_API_KEY=your_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGION=us
ODDS_API_FORMAT=american

# NextAuth Configuration
# Authentication secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Email Provider (Resend)
# Sign up at https://resend.com to get your API key
AUTH_RESEND_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Admin Email - ONLY this email can access admin panel
ADMIN_EMAIL=youremail@example.com

# GNews API Configuration
# Sign up at https://gnews.io to get your API key
GNEWS_API_KEY=your_gnews_api_key_here

# NewsAPI Configuration
# Sign up at https://newsapi.org to get your API key (100 requests/day free)
NEWSAPI_KEY=your_newsapi_key_here
