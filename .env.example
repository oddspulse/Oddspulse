# The Odds API Configuration
# Get your free API key at: https://the-odds-api.com/
ODDS_API_KEY=your_api_key_here

# Optional: Base URL for The Odds API (default shown below)
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Optional: Default region for odds (us, uk, eu, au)
ODDS_API_REGION=us

# Optional: Odds format (american, decimal)
ODDS_API_FORMAT=american
